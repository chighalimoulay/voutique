# ══════════════════════════════════════════════════════════════════
#  إعدادات Supabase لمتجر VOUTIQUE
#
#  انسخي هذا الملف إلى ‎.env.local‎ ثم املئي القيم.
#  ‎.env.local‎ لا يُرفع إلى Git (مذكور في ‎.gitignore‎).
# ══════════════════════════════════════════════════════════════════

# رابط مشروع Supabase، مثل: https://xxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# المفتاح العام (publishable / anon) — آمن للاستخدام في الواجهة.
# الحماية الحقيقية عبر Row Level Security وليست بإخفاء هذا المفتاح.
VITE_SUPABASE_ANON_KEY=

# ملاحظة: لا يوجد service-role / secret key في الواجهة إطلاقًا.
# إعداد قاعدة البيانات يتم بلصق ملفات supabase/migrations/*.sql
# في «SQL Editor» داخل لوحة Supabase، فلا حاجة لأي مفتاح سري محليًا.
